# Names and placeholders only (Annex J.5.1). Copy to env/qa.env, which is git-ignored, and fill it in.
# qa: the real values come from the secret of the environment, never from this repository.
COMPOSE_PROJECT_NAME=csp-qa

# Operation and health check of the instance; no service uses it.
REDIS_ADMIN_PASSWORD=
# Password of the auth_app user (limited to attempts:*, locked:* and blacklist:*). It goes inside APP_AUTH_REDIS_URL,
# so it must be URL-safe: openssl rand -hex 24
AUTH_REDIS_PASSWORD=
# Upper bound of the memory of the instance (5.3.10). Keys are evicted by shortest TTL when it is reached.
REDIS_MAXMEMORY=64mb

# What csp-auth-api reads. Redis is reached by its service name on the platform network, never by localhost.
APP_AUTH_REDIS_URL=redis://auth_app:${AUTH_REDIS_PASSWORD}@redis:6379/0
